<!--
  Reference only — this is NOT a working project file by itself.

  Identity/Publisher below are the REAL values from Partner Center's "Reserve a new app name"
  (reserved for "Brightly Tray - Monitor Brightness Control Slider") — already filled in, no
  placeholders left in <Identity>/<Properties>.

  Other identifiers Partner Center generated at the same time, kept here for reference (none of
  these go in the manifest itself — they're derived automatically from Name+Publisher above):
    Package Family Name : blockbusterandy.BrightlyTray-MonitorBrightnessCont_58e7665kaf4ew
    Package SID         : S-1-15-2-334121341-2768081639-4137052589-189496784-282925544-4246922499-839511274
    Store ID            : 9ND62D4LR0ZT

  Visual Studio's "Windows Application Packaging Project" template generates a full,
  correctly-formed Package.appxmanifest for you (with all the required namespace imports,
  build actions, etc.). Do not replace that generated file wholesale — instead, open it and:

    1. Copy the <Identity> and <Properties> values below in verbatim.
    2. Copy the <Extensions> block below into the generated <Application> element, so the
       "Start with Windows" feature works correctly once packaged (see StartupService.cs).
    3. Copy the <uap:VisualElements> DisplayName/Description below.
    4. Point the Logo/Square*Logo/StoreLogo attributes at the files in this store-assets
       folder (or files VS's asset generator derives from MasterIcon-1024.png).

  TaskId below ("MonitorBrightnessStartup") must match PackagedStartupTaskId in
  src/MonitorBrightness/Services/StartupService.cs exactly, or the startup toggle will
  silently do nothing once packaged.

  NOTE on the two display names below: Properties/DisplayName uses the full reserved name —
  that's what shows as the Store listing title and is fine at full length there.
  uap:VisualElements/DisplayName uses the short form "Brightly Tray" instead, because THAT one
  renders under the icon on Start menu tiles/taskbar, where the full ~47-character name would
  just get truncated. Both are valid; they don't have to match each other.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="blockbusterandy.BrightlyTray-MonitorBrightnessCont"
    Publisher="CN=9E4A3ABC-BFE5-4503-9D3D-058DF943B4BA"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>Brightly Tray - Monitor Brightness Control Slider</DisplayName>
    <PublisherDisplayName>blockbusterandy</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MonitorBrightness.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Brightly Tray"
        Description="Tray-based brightness control for laptop panels, external DDC/CI monitors, and HDR displays."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>

      <!-- Required for the "Start with Windows" tray menu toggle to work once packaged.
           TaskId must exactly match PackagedStartupTaskId in StartupService.cs. -->
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="MonitorBrightness.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MonitorBrightnessStartup" Enabled="false" DisplayName="Brightly Tray" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Required for any classic Win32/.NET exe (P/Invoke, WMI, registry, DDC/CI all need this). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
